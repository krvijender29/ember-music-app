<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Obsidian Noir Acrylic Surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0A0A0E" />
        </shape>
    </item>

    <!-- Bottom 1px Subtle Border (rgba(255, 255, 255, 0.10)) -->
    <item
        android:top="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
