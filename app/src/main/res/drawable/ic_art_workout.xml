<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="146dp"
    android:viewportWidth="120"
    android:viewportHeight="146">

    <!-- Deep Neon Purple/Violet Background -->
    <path
        android:pathData="M0,0 L120,0 L120,146 L0,146 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startX="60"
                android:startY="0"
                android:endX="60"
                android:endY="146"
                android:type="linear">
                <item android:color="#1A132C" android:offset="0.0" />
                <item android:color="#2B1542" android:offset="0.4" />
                <item android:color="#3C1A58" android:offset="0.7" />
                <item android:color="#10081C" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neon Aura / Purple Light Halo -->
    <path
        android:pathData="M 62,64 m -38,0 a 38,38 0 1,0 76,0 a 38,38 0 1,0 -76,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="62"
                android:centerY="64"
                android:gradientRadius="38"
                android:type="radial">
                <item android:color="#50A855F7" android:offset="0.0" />
                <item android:color="#207C3AED" android:offset="0.6" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Athletic Profile Silhouette (Head & Shoulders facing right) -->
    <!-- Shoulders & Upper Chest -->
    <path
        android:fillColor="#0D0817"
        android:pathData="M 20,118 C 28,102 42,94 54,92 C 60,91 66,92 72,96 C 82,102 96,108 106,120 L 106,146 L 20,146 Z" />

    <!-- Neck & Jawline -->
    <path
        android:fillColor="#0E0919"
        android:pathData="M 48,78 C 48,88 52,94 62,94 C 70,94 74,86 76,78 Z" />

    <!-- Head Profile -->
    <path
        android:fillColor="#110A1E"
        android:pathData="M 60,42 C 50,42 45,50 45,62 C 45,72 50,80 62,80 C 72,80 78,74 80,68 C 82,64 80,58 78,54 C 74,46 68,42 60,42 Z" />

    <!-- Over-Ear Headphones (Neon Glow & Structure) -->
    <!-- Headband -->
    <path
        android:strokeColor="#C084FC"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M 44,66 C 42,46 54,34 68,36 C 76,37 82,44 84,56" />

    <!-- Headband Accent Trim -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.6"
        android:strokeLineCap="round"
        android:pathData="M 48,56 C 47,44 56,36 67,37" />

    <!-- Large Ear Cup Outer Ring (Glowing Neon Magenta/Violet) -->
    <path
        android:strokeColor="#E879F9"
        android:strokeWidth="3"
        android:fillColor="#1F1032"
        android:pathData="M 64,65 m -11,0 a 11,14 0 1,0 22,0 a 11,14 0 1,0 -22,0" />

    <!-- Ear Cup Inner Highlight -->
    <path
        android:fillColor="#A855F7"
        android:pathData="M 64,65 m -6,0 a 6,9 0 1,0 12,0 a 6,9 0 1,0 -12,0" />

    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.8"
        android:pathData="M 62,62 m -2,0 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0" />

    <!-- Subtle Vignette / Shadow at bottom for text readability -->
    <path
        android:pathData="M0,95 L120,95 L120,146 L0,146 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startX="60"
                android:startY="95"
                android:endX="60"
                android:endY="146"
                android:type="linear">
                <item android:color="#00000000" android:offset="0.0" />
                <item android:color="#D0080410" android:offset="0.6" />
                <item android:color="#F4080410" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
