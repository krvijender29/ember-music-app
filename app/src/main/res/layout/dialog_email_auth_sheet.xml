<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="14dp"
    android:paddingEnd="24dp"
    android:paddingBottom="36dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="42dp"
        android:layout_height="4.5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/nav_indicator_pill"
        android:backgroundTint="#333346" />

    <!-- Title & Subtitle -->
    <TextView
        android:id="@+id/tvModalAuthTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Sign In to EMBER"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Synchronize your playlists, likes, and listening history across devices."
        android:textColor="#9E9EB2"
        android:textSize="12.5sp" />

    <!-- Tabs Switcher: Sign In vs Create Account -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/search_box_bg"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabModalSignIn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/editorial_badge_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Sign In"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabModalSignUp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Create Account"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Error Text View -->
    <TextView
        android:id="@+id/tvModalAuthError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:textColor="#FF453A"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Name Field (Visible on Sign Up) -->
    <EditText
        android:id="@+id/etModalName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/search_box_bg"
        android:hint="Your Name"
        android:inputType="textPersonName"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/white"
        android:textColorHint="#6B7280"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Email Field -->
    <EditText
        android:id="@+id/etModalEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/search_box_bg"
        android:hint="Email Address"
        android:inputType="textEmailAddress"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/white"
        android:textColorHint="#6B7280"
        android:textSize="14sp" />

    <!-- Password Field -->
    <EditText
        android:id="@+id/etModalPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/search_box_bg"
        android:hint="Password"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/white"
        android:textColorHint="#6B7280"
        android:textSize="14sp" />

    <!-- Submit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnModalAuthSubmit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/accent_primary"
        android:text="Sign In to EMBER"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pbModalAuthLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:indeterminateTint="@color/accent_primary"
        android:visibility="gone" />

    <!-- Footer Notice -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="🔒 Secure Cloud Sync • Lossless Studio Audio"
        android:textColor="#666678"
        android:textSize="11sp" />
</LinearLayout>
