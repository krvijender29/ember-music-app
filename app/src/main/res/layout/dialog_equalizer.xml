<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/eq_card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/sheet_drag_handle_bg" />

    <!-- 1. Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <!-- Left: Icon + Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_equalizer"
                app:tint="#FF5A36" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-black"
                android:text="Audio Equalizer"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right: Enable Switch + Close Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEqEnable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:checked="true"
                app:thumbTint="#FF5A36"
                app:trackTint="#40FF5A36" />

            <ImageButton
                android:id="@+id/btnCloseEQ"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/circle_dark_action_bg"
                android:contentDescription="Close Equalizer"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="#A1A1AA" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. Presets Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutEqPresets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPresetFlat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/eq_preset_pill_active"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="Flat"
                android:textColor="#FF5A36"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPresetBass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/eq_preset_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="Bass Boost"
                android:textColor="#A1A1AA"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnPresetVocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/eq_preset_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="Vocal"
                android:textColor="#A1A1AA"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnPresetEdm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/eq_preset_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="EDM"
                android:textColor="#A1A1AA"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnPresetRock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/eq_preset_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="Rock"
                android:textColor="#A1A1AA"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnPresetPodcast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/eq_preset_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="Podcast"
                android:textColor="#A1A1AA"
                android:textSize="12.5sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. 5-Band Vertical Sliders Housing -->
    <LinearLayout
        android:id="@+id/layoutSlidersHousing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/eq_sliders_housing_bg"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="18dp"
        android:paddingEnd="10dp"
        android:paddingBottom="18dp">

        <!-- Column 1: 60Hz (SUB) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEqBadge1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/eq_badge_bg"
                android:fontFamily="monospace"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="0dB"
                android:textColor="#FF9472"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.example.ember.ui.VerticalEqSliderView
                android:id="@+id/sliderEqBand1"
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60Hz"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:text="SUB"
                android:textColor="#71717A"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Column 2: 230Hz (BASS) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEqBadge2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/eq_badge_bg"
                android:fontFamily="monospace"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="0dB"
                android:textColor="#FF9472"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.example.ember.ui.VerticalEqSliderView
                android:id="@+id/sliderEqBand2"
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="230Hz"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:text="BASS"
                android:textColor="#71717A"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Column 3: 910Hz (MID) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEqBadge3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/eq_badge_bg"
                android:fontFamily="monospace"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="0dB"
                android:textColor="#FF9472"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.example.ember.ui.VerticalEqSliderView
                android:id="@+id/sliderEqBand3"
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="910Hz"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:text="MID"
                android:textColor="#71717A"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Column 4: 3.6kHz (HIGH) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEqBadge4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/eq_badge_bg"
                android:fontFamily="monospace"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="0dB"
                android:textColor="#FF9472"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.example.ember.ui.VerticalEqSliderView
                android:id="@+id/sliderEqBand4"
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.6kHz"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:text="HIGH"
                android:textColor="#71717A"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Column 5: 14kHz (AIR) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEqBadge5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/eq_badge_bg"
                android:fontFamily="monospace"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="0dB"
                android:textColor="#FF9472"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.example.ember.ui.VerticalEqSliderView
                android:id="@+id/sliderEqBand5"
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14kHz"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:text="AIR"
                android:textColor="#71717A"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Footer Status Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvEqProfileStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:text="Profile: Flat"
            android:textColor="#A1A1AA"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnResetFlat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/eq_reset_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="Reset to Flat"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>
</LinearLayout>
