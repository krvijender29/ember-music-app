<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutSuggestionRow"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Search Icon with subtle badge -->
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/suggestion_icon_bg">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />
        </FrameLayout>

        <!-- Suggestion Title -->
        <TextView
            android:id="@+id/tvSuggestionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Navaan Sandhu"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <!-- Diagonal Insert Arrow Button -->
        <ImageView
            android:id="@+id/btnSuggestionInsert"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/circle_frosted_btn_bg"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_insert"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- Subtle divider -->
    <View
        android:id="@+id/viewSuggestionDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="58dp"
        android:background="@color/border_subtle" />
</LinearLayout>
